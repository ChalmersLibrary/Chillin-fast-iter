<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone CLI tool: hashes a password into the exact PasswordHasher<T>/IdentityV2 format
       Chalmers.ILL.Members.FileMembershipProvider and MemberAdminService expect in members.json.
       Needed because the very first account (bootstrap SuperAdmin) has no UI path - MemberAdminService
       requires being logged in already - see TODO-remove-dotnet-framework.md fas 10, "Lägg upp ett
       bootstrap-SuperAdmin-konto". FrameworkReference only, no PackageReference needed: PasswordHasher<T>
       ships in the ASP.NET Core shared framework, so this builds and runs fully offline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Chalmers.ILL.HashPassword</RootNamespace>
    <AssemblyName>Chalmers.ILL.HashPassword</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chalmers.ILL\Chalmers.ILL.csproj" />
  </ItemGroup>

</Project>
