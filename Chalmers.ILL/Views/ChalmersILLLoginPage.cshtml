@{
    Layout = null;
}
@{
    var isNotLocalhost = Request.Host.Host != "localhost";
    var isNotTestServer = Request.Host.Host != Config.TestServer;
    var isNotSecureLiveServer = !(Request.IsHttps && Request.Host.Host == Config.LiveServer);
    if (isNotLocalhost && isNotTestServer && isNotSecureLiveServer)
    {
        // Fas 10: see ChalmersILL.cshtml for why this needs an explicit `return;` and a temporary
        // (302) redirect instead of the old Response.Redirect(url, true).
        Response.Redirect("https://" + Config.LiveServer);
        return;
    }
}
<!doctype html>
<html>
<head>
    <title>Chalmers fjärrlån &amp; bokförvärv</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
