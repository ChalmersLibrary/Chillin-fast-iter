@model Chalmers.ILL.Models.PartialPage.Settings.MemberAdmin

<div class="col-lg-12">
    <h3>Skapa nytt konto</h3>
    <div class="form-group">
        <label for="new-member-login">Inloggningsnamn</label>
        <input type="text" class="form-control" data-testid="new-member-login" id="new-member-login" name="new-member-login">
        <label for="new-member-password">Lösenord</label>
        <input type="text" class="form-control" data-testid="new-member-password" id="new-member-password" name="new-member-password">
        <label for="new-member-roles">Roller (kommaseparerat, t.ex. Desk, Administrator)</label>
        <input type="text" class="form-control" data-testid="new-member-roles" id="new-member-roles" name="new-member-roles">
    </div>
    <button class="btn btn-success" data-testid="create-member" onclick="createMember();">Skapa konto</button>
</div>

<div class="col-lg-12">
    <h3>Konton</h3>
    <table class="table" id="member-admin-table">
        <thead>
            <tr>
                <th>Inloggningsnamn</th>
                <th>Roller</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model.Members)
            {
                <tr data-login="@member.Login">
                    <td>@member.Login</td>
                    <td>
                        <input type="text" class="form-control member-roles-input" value="@string.Join(", ", member.Roles)">
                        <button class="btn btn-default btn-xs" data-testid="save-member-roles" onclick="saveRoles(this);">Spara roller</button>
                    </td>
                    <td>
                        <button class="btn btn-default btn-xs" onclick="setPassword(this);">Sätt nytt lösenord</button>
                        <button class="btn btn-danger btn-xs" data-testid="delete-member" onclick="deleteMember(this);">Ta bort</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script type="text/javascript">
    function createMember() {
        var login = $("#new-member-login").val().trim();
        var password = $("#new-member-password").val();
        var roles = $("#new-member-roles").val();
        if (!login || !password) {
            alert("Inloggningsnamn och lösenord krävs.");
            return;
        }
        lockScreen();
        $.post("/MemberAdminSurface/CreateMember", { login: login, password: password, roles: roles }).done(function (json) {
            if (!json.Success) {
                alert(json.Message);
                unlockScreen();
            } else {
                $("#member-settings-link").click();
            }
        }).fail(function (jqxhr, textStatus, error) {
            alert("Error: " + textStatus + " " + error);
            unlockScreen();
        });
    }

    function saveRoles(btn) {
        var row = $(btn).closest("tr");
        var login = row.data("login");
        var roles = row.find(".member-roles-input").val();
        lockScreen();
        $.post("/MemberAdminSurface/SetMemberRoles", { login: login, roles: roles }).done(function (json) {
            if (!json.Success) {
                alert(json.Message);
            }
            unlockScreen();
        }).fail(function (jqxhr, textStatus, error) {
            alert("Error: " + textStatus + " " + error);
            unlockScreen();
        });
    }

    function setPassword(btn) {
        var row = $(btn).closest("tr");
        var login = row.data("login");
        var newPassword = prompt("Nytt lösenord för " + login + ":");
        if (!newPassword) return;
        lockScreen();
        $.post("/MemberAdminSurface/SetMemberPassword", { login: login, newPassword: newPassword }).done(function (json) {
            alert(json.Message);
            unlockScreen();
        }).fail(function (jqxhr, textStatus, error) {
            alert("Error: " + textStatus + " " + error);
            unlockScreen();
        });
    }

    function deleteMember(btn) {
        var row = $(btn).closest("tr");
        var login = row.data("login");
        if (!confirm("Ta bort kontot \"" + login + "\"?")) return;
        lockScreen();
        $.post("/MemberAdminSurface/DeleteMember", { login: login }).done(function (json) {
            if (!json.Success) {
                alert(json.Message);
                unlockScreen();
            } else {
                $("#member-settings-link").click();
            }
        }).fail(function (jqxhr, textStatus, error) {
            alert("Error: " + textStatus + " " + error);
            unlockScreen();
        });
    }
</script>
