<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.config's <appSettings> is never read by Kestrel - that mechanism was always IIS/System.Web-
  specific, not something the TFM switch could carry over automatically. Without this file the app
  crashes on startup (DefaultChillinConfiguration.ElasticSearchUrl etc. come back null). This is
  really fas 6's job (ConfigurationManager.AppSettings -> IConfiguration/appsettings.json), but a
  working config is a hard prerequisite for reaching the "brytpunkt efter fas 2" at all, so this
  bridges it with zero code changes: System.Configuration.ConfigurationManager resolves
  {entry assembly}.dll.config automatically, and the SDK copies App.config there on build - the
  same mechanism already verified working for Chalmers.ILL.Tests/app.config.
  Values below match Web.config's local-dev defaults (docker-compose ES/Azurite, no real secrets -
  Web.config's own secret placeholders were already "xxx"/"******", not real values).
-->
<configuration>
  <appSettings>
    <!-- Hosts -->
    <add key="testServer" value="localhost" />
    <add key="liveServer" value="xxx" />
    <!-- White list -->
    <add key="cronServerIpAddress" value="127.0.0.1" />
    <!-- Main mailbox (Microsoft Graph API) -->
    <add key="UseMicrosoftGraphMailService" value="true" />
    <add key="MicrosoftGraphApiUserId" value="******" />
    <add key="MicrosoftGraphClientId" value="******" />
    <add key="MicrosoftGraphClientSecret" value="******" />
    <add key="MicrosoftGraphAuthority" value="******" />
    <add key="MicrosoftGraphApiEndpoint" value="******" />
    <!-- Mailing lists (CSV) -->
    <add key="bugFixersMailingList" value="" />
    <!-- Sierra -->
    <add key="sierraConnectionString" value="******" />
    <!-- Libris -->
    <add key="librisApiBaseAddress" value="xxx" />
    <add key="librisApiUserRequestSuffix" value="xxx" />
    <add key="librisApiKey" value="******" />
    <add key="librarySigel" value="xxx" />
    <!-- FOLIO -->
    <add key="folioApiBaseAddress" value="xxx" />
    <add key="folioXOkapiTenant" value="xxx" />
    <add key="folioUsername" value="xxx" />
    <add key="folioPassword" value="xxx" />
    <add key="folioSourceId" value="xxx" />
    <!-- Patron Cache -->
    <add key="patronCacheSolrQueryUrl" value="xxx" />
    <add key="patronAffiliationSolrQueryUrl" value="xxx" />
    <add key="patronCacheSolrBasicAuthUsername" value="" />
    <add key="patronCacheSolrBasicAuthPassword" value="" />
    <add key="orderListPageUrl" value="/bestaellningar" />
    <!-- Signature and subject -->
    <add key="chalmersILLMailSignature" value="xxx" />
    <add key="chalmersILLMailSubject" value="xxx" />
    <!-- Texts -->
    <add key="messageTemplatesLink" value="#" />
    <add key="statusEditingAtMailSendInfo" value="Här ska det stå information om hur man ska tänka när man sätter den här statusen!" />
    <!-- Storage -->
    <add key="BaseUrl" value="http://localhost:5000/" />
    <add key="ElasticSearchUrl" value="http://localhost:9200" />
    <add key="ElasticSearchIndex" value="chillindev" />
    <add key="ElasticSearchTemplatesIndex" value="chillindev-templates" />
    <add key="BlobStorageConnectionString" value="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;TableEndpoint=http://localhost:10002/devstoreaccount1;QueueEndpoint=http://localhost:10001/devstoreaccount1;" />
    <!-- No SQL Server in the devcontainer (fas 7 removes the database) - leave off so DbMigrator
         is never invoked against a connection string that doesn't resolve to anything real here. -->
    <add key="checkForPendingDatabaseMigrations" value="false" />
    <!-- Misc -->
    <add key="showManulMailFetchingTools" value="false" />
    <add key="statisticsUrl" value="" />
    <add key="ManualAnonymizationImplementationDate" value="2024-11-23" />
  </appSettings>
</configuration>
