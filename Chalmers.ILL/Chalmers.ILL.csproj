<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Chalmers.ILL</RootNamespace>
    <AssemblyName>Chalmers.ILL</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- members.json/chillinPrevalues.json themselves are no longer read from here (fas 6,
         isolerat läge steg A, "Datarot") - IChillinConfiguration.DataPath is now the only source of
         truth for where they live. The .example.json templates stay for reference. -->
    <Content Update="Config\members.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Config\log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Database removal (fas 7) is a separate, later phase - EF6 stays for now. EF6 supports
         net5.0+ since 6.3, so it isn't blocked by the TFM switch itself. -->
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="Elasticsearch.Net" Version="6.3.1" />
    <PackageReference Include="NEST" Version="6.3.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.4.6" />
    <PackageReference Include="log4net" Version="2.0.12" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.48.1" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="6.22.0" />
    <!-- Newtonsoft.Json 8.0.1 predates netstandard support and cannot be restored for
         net10.0 - bumped to a version with a net-modern target. No API used here changed. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <!-- WindowsAzure.Storage (legacy SDK, .NET Framework-only) replaced by Azure.Storage.Blobs
         in BlobStorageMediaItemManager - this was fas 8, pulled forward because the old
         package's dependency chain (Microsoft.Data.OData etc.) cannot target net10.0. -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <!-- EWS-Api-2.0 (Exchange Web Services managed API) is .NET Framework-only and has no
         net10.0-compatible build. Graph is the confirmed production mail path (see CLAUDE.md
         designbeslut), so EWS is removed entirely here instead of migrated - this is fas 8's
         "Ta bort EWS helt", pulled forward because the package physically cannot restore for
         net10.0, not because fas 8 was otherwise ready. -->
  </ItemGroup>

</Project>
