<?xml version="1.0" encoding="utf-8"?>
<log4net>
  <!-- fas 0a: was Umbraco.Core.Logging.AsynchronousRollingFileAppender, a type in a package
       that's since been removed. This file itself was missing from the repository entirely
       (verified: no trace in git history) despite Web.config's <log4net configSource="config\log4net.config" />
       pointing at it and the fas 0a TODO item being checked off - the appender-type fix was
       made without ever committing the config file it was supposed to fix. -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="App_Data/Logs/ChillinTraceLog.txt" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="yyyyMMdd" />
    <staticLogFileName value="true" />
    <maxSizeRollBackups value="30" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
    </layout>
  </appender>
  <root>
    <level value="INFO" />
    <appender-ref ref="RollingFileAppender" />
  </root>
</log4net>
