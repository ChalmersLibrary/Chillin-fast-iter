@model ClaudePageModel
@* "Bolla en idé med Claude" (DESIGN.md, "Idéer"): the chat box on the start page. Model.Conversation
   is the idea in the box, or null for a new one. Also served on its own (/Claude/IdeaPanel), so
   claude.js can swap it in once a first message has made the idea - without reloading the page. *@
@{
    var idea = Model.Conversation;
}
<div class="panel panel-default" id="claude-idea" data-testid="claude-idea" data-idea-id="@idea?.Id" style="scroll-margin-top: 70px;">
    <div class="panel-heading">
        <strong>Bolla en idé med Claude</strong>
        @if (idea != null)
        {
            <a class="pull-right" href="/?idea=ny#claude-idea">Ny idé</a>
        }
    </div>
    <div class="panel-body">
        @if (idea != null)
        {
            <div data-claude-refresh="/Claude/IdeaChat/@idea.Id">
                @await Html.PartialAsync("~/Views/Claudeborgen/_IdeaChat.cshtml", Model)
            </div>
        }
        else
        {
            <p class="text-muted">Skriv en tanke, ett problem eller en önskan, hur ofärdig som helst. Claude tittar i koden och hjälper dig fundera på om det är värt att bygga. Inget byggs förrän du säger till.</p>
        }

        @if (Model.Access.CanWrite)
        {
            <form method="post" action="@(idea != null ? $"/Claude/Reply/{idea.Id}" : "/Claude/Idea")" data-testid="claude-idea-form" data-claude-send>
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <textarea class="form-control" name="body" rows="2" required data-enter-sends placeholder="@(idea != null ? "Svara Claude…" : "Jag funderar på…")"></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Skicka</button>
                <span class="help-block" style="display: inline; margin-left: 8px;">Enter skickar, Shift+Enter ger ny rad. Inga personuppgifter – allt du skriver skickas till Claude.</span>
            </form>
        }

        @if (idea != null)
        {
            <hr />
            @* Two buttons, nothing to fill in: going ahead turns the idea into work (titled from the
               first message), clearing it removes the discussion. *@
            <div>
                @if (Model.Access.CanStartAndClose)
                {
                    <form method="post" action="/Claude/Convert/@idea.Id" style="display: inline;" data-testid="claude-convert-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">Gå vidare</button>
                    </form>
                }
                @if (Model.Access.CanWrite)
                {
                    <form method="post" action="/Claude/Cancel/@idea.Id" style="display: inline;" onsubmit="return confirm('Rensa diskussionen? Den tas bort.');" data-testid="claude-drop-idea-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-default btn-sm">Rensa diskussion</button>
                    </form>
                }
            </div>
        }
    </div>
</div>
