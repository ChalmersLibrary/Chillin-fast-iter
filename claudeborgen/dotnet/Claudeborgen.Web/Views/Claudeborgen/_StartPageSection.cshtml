@inject ClaudeborgenService ClaudeService
@inject IClaudeborgenHost ClaudeHost
@* Claudeborgen's overview, rendered by the host where its changelog lives (DESIGN.md,
   "Placering"; in Chillin right above "Nytt i Chillin" on the start page): a chat box to bounce
   ideas with Claude (DESIGN.md, "Idéer"), Claude's status, what needs IT, the open work and ideas.
   Finished work lands in the changelog (_Changelog.cshtml). *@
@if (ClaudeService.Settings.IsOn)
{
    var claude = new ClaudePageModel
    {
        Settings = ClaudeService.Settings,
        Access = ClaudeHost.AccessFor(User),
        Status = ClaudeService.GetStatus(),
        NeedingAttention = ClaudeService.NeedingAttention(),
        Conversations = ClaudeService.All(),
        Error = TempData[ClaudeController.ErrorKey] as string,
    };

    // The idea in the chat box: the one asked for (?idea=), else your own most recent open one.
    var openIdeas = claude.Conversations.Where(c => c.IsIdea && c.IsOpen).ToList();
    var requested = int.TryParse(Context.Request.Query["idea"], out var requestedId) ? openIdeas.FirstOrDefault(c => c.Id == requestedId) : null;
    var newIdea = Context.Request.Query["idea"] == "ny";
    var idea = newIdea ? null : requested ?? openIdeas.Where(c => c.CreatedBy == User.Identity?.Name).OrderByDescending(c => c.LastActivityAt).FirstOrDefault();
    var ideaModel = idea == null ? null : new ClaudePageModel { Settings = claude.Settings, Access = claude.Access, Status = claude.Status, Conversation = idea };

    <div data-testid="claude-section">
        <h3>Claude</h3>

        @if (!string.IsNullOrEmpty(claude.Error))
        {
            <div class="alert alert-danger" data-testid="claude-error">@claude.Error</div>
        }

        <div class="panel panel-default" id="claude-idea" data-testid="claude-idea" style="scroll-margin-top: 70px;">
            <div class="panel-heading">
                <strong>Bolla en idé med Claude</strong>
                @if (idea != null)
                {
                    <a class="pull-right" href="/?idea=ny#claude-idea">Ny idé</a>
                }
            </div>
            <div class="panel-body">
                @if (idea != null)
                {
                    <div data-claude-refresh="/Claude/IdeaChat/@idea.Id">
                        @await Html.PartialAsync("~/Views/Claudeborgen/_IdeaChat.cshtml", ideaModel)
                    </div>
                }
                else
                {
                    <p class="text-muted">Skriv en tanke, ett problem eller en önskan, hur ofärdig som helst. Claude tittar i koden och hjälper dig fundera på om det är värt att bygga. Inget byggs förrän du säger till.</p>
                }

                @if (claude.Access.CanWrite)
                {
                    <form method="post" action="@(idea != null ? $"/Claude/Reply/{idea.Id}" : "/Claude/Idea")" data-testid="claude-idea-form">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <textarea class="form-control" name="body" rows="2" required data-enter-sends placeholder="@(idea != null ? "Svara Claude…" : "Jag funderar på…")"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Skicka</button>
                        <span class="help-block" style="display: inline; margin-left: 8px;">Enter skickar, Shift+Enter ger ny rad. Inga personuppgifter – allt du skriver skickas till Claude.</span>
                    </form>
                }

                @if (idea != null)
                {
                    <hr />
                    @* Two buttons, nothing to fill in: going ahead turns the idea into work (titled from the
                       first message), clearing it removes the discussion. *@
                    <div>
                        @if (claude.Access.CanStartAndClose)
                        {
                            <form method="post" action="/Claude/Convert/@idea.Id" style="display: inline;" data-testid="claude-convert-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm">Gå vidare</button>
                            </form>
                        }
                        @if (claude.Access.CanWrite)
                        {
                            <form method="post" action="/Claude/Cancel/@idea.Id" style="display: inline;" onsubmit="return confirm('Rensa diskussionen? Den tas bort.');" data-testid="claude-drop-idea-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-default btn-sm">Rensa diskussion</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>

        <div id="claude-live" data-claude-refresh="/Claude/IndexContent">
            @await Html.PartialAsync("~/Views/Claudeborgen/_IndexContent.cshtml", claude)
        </div>

        @if (claude.Access.CanStartAndClose)
        {
            <p>
                <button class="btn btn-default btn-sm" type="button" data-toggle="collapse" data-target="#claude-start" aria-expanded="false" data-testid="claude-start-toggle">Nytt arbete direkt</button>
                <span class="text-muted small">– om du redan vet exakt vad som ska göras</span>
            </p>
            <div class="collapse" id="claude-start">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <form method="post" action="/Claude/Start" data-testid="claude-start-form">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label for="claude-title">Rubrik</label>
                                <input type="text" class="form-control" id="claude-title" name="title" maxlength="200" required placeholder="T.ex. Exportknapp på beställningslistan">
                            </div>
                            <div class="form-group">
                                <label for="claude-body">Vad ska Claude göra?</label>
                                <textarea class="form-control" id="claude-body" name="body" rows="5" required></textarea>
                                <p class="help-block">Skriv inga personuppgifter – allt du skriver skickas till Claude.</p>
                            </div>
                            <button type="submit" class="btn btn-primary">Starta arbetet</button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* ?v= the deployed commit: a new deployment is never stuck with a cached old script. *@
        <script src="/_content/Claudeborgen.Web/claude.js?v=@(ClaudeService.Settings.DeployedCommit() ?? "dev")" type="text/javascript"></script>
    </div>
}
