@model ClaudePageModel
@{
    var status = Model.Status;
}
@{
    var panelClass = status.Activity switch
    {
        ClaudeActivity.Working => "panel-primary",
        ClaudeActivity.Idle => "panel-success",
        ClaudeActivity.Paused => "panel-warning",
        _ => "panel-default"
    };
}
@* DESIGN.md, "Pausa utvecklingen": shown to everyone; the switch is ObjektSpecialistIT's. *@
@if (status.DevelopmentPause != null)
{
    <div class="alert alert-warning" data-testid="claude-development-paused">
        @if (Model.Access.IsIt)
        {
            <form method="post" action="/Claude/ResumeDevelopment" class="pull-right" style="margin-left: 12px;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-default btn-sm" data-testid="claude-resume-development">Återuppta utvecklingen</button>
            </form>
        }
        <strong>Utvecklingen är pausad</strong> av @status.DevelopmentPause.PausedBy sedan @ClaudeText.Time(status.DevelopmentPause.PausedAt).
        Claude bygger, pushar och tar inte bort något förrän den återupptas@(status.Activity == ClaudeActivity.Working ? " – varvet som pågår nu avslutas först" : "").
        Meddelanden går att skriva och väntar i kön, och idéchatten fungerar som vanligt.
    </div>
}
else if (Model.Access.IsIt)
{
    <form method="post" action="/Claude/PauseDevelopment" class="text-right" style="margin-bottom: 8px;"
          onsubmit="return confirm('Pausa utvecklingen? Claude bygger och pushar ingenting förrän du återupptar den.');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-default btn-xs" data-testid="claude-pause-development" title="T.ex. när någon behöver arbeta i grenen för hand, så att det inte blir mergekonflikter.">Pausa utvecklingen</button>
    </form>
}

<div class="panel @panelClass" data-testid="claude-status" data-activity="@status.Activity">
    <div class="panel-heading">
        <strong>
            @switch (status.Activity)
            {
                case ClaudeActivity.Working:
                    @:Claude jobbar på <a href="/Claude/Conversation/@status.ConversationId" style="color: inherit; text-decoration: underline;">#@status.ConversationId @status.ConversationTitle</a>
                    break;
                case ClaudeActivity.Idle:
                    @:Claude är ledig
                    break;
                case ClaudeActivity.Paused:
                    @:Claude är pausad@(status.PausedUntil != null ? ", försöker igen kl. " + status.PausedUntil.Value.ToString("HH:mm") : "")
                    break;
                default:
                    @:Claude är offline@(status.LastHeartbeatAt != null ? " sedan " + ClaudeText.Time(status.LastHeartbeatAt) : "")
                    break;
            }
        </strong>
        @if ((status.Activity == ClaudeActivity.Working || status.Activity == ClaudeActivity.Paused) && !string.IsNullOrEmpty(status.Phase))
        {
            <span> · @status.Phase</span>
        }
        <span class="pull-right">@status.QueueLength i kö</span>
    </div>
    @if (Model.Settings.IsFake)
    {
        <div class="panel-body" data-testid="claude-fake-banner">
            <strong>Fejkad Claude.</strong>
            @if (Model.Settings.Mode == ClaudeborgenMode.FakeRunner)
            {
                @:Det här är snabbtestservern: svaren kommer från en runner i fejkläge, ingenting ändras eller pushas.
            }
            else
            {
                @:Det här är snabbtestservern: svaren kommer från en fejk, ingenting ändras eller pushas.
            }
            Styr den med <code>[röd]</code>, <code>[röd!]</code>, <code>[krasch]</code>, <code>[offline]</code>, <code>[kvot]</code> eller <code>[fråga]</code> i meddelandet.
        </div>
    }
</div>

@if (Model.NeedingAttention.Count > 0)
{
    <div class="panel @(Model.Access.IsIt ? "panel-danger" : "panel-warning")" data-testid="claude-attention">
        <div class="panel-heading"><strong>Behöver IT</strong></div>
        <ul class="list-group">
            @foreach (var c in Model.NeedingAttention)
            {
                <li class="list-group-item">
                    <a href="/Claude/Conversation/@c.Id">#@c.Id @c.Title</a>
                    – @(c.NeedsIt ? c.NeedsItReason : "Claude gick offline mitt i ett varv.")
                </li>
            }
        </ul>
    </div>
}
