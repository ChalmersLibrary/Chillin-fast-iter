@inject ClaudeborgenService ClaudeService
@* Conversations marked done, as entries under "Nytt i Chillin" on the start page - above the
   hand-written version entries, which stay as history. *@
@if (ClaudeService.Settings.IsOn)
{
    foreach (var c in ClaudeService.Changelog())
    {
        <li class="list-group-item" data-testid="claude-changelog-entry">
            <h4>@(c.DoneAt?.ToString("yyyy-MM-dd"))</h4>
            <ul>
                <li><a href="/Claude/Conversation/@c.Id">@c.ChangelogText</a></li>
            </ul>
        </li>
    }
}
